{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "1.0.0"
  },
  "environment": {
    "name": "invoice-portal-api",
    "instance": null,
    "message": "Globex Finance's supplier portal API answers at http://127.0.0.1:${published.web.portal}/.\nStart with the documentation it publishes; the invoice you are after is INV-20507.\n"
  },
  "target": "cloud-docker",
  "cloud": "digitalocean",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "fra1",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "size",
      "description": "The module's `size`.",
      "default": "s-2vcpu-4gb",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "size"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-networks",
            "check-database",
            "check-web"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "DIGITALOCEAN_TOKEN",
      "kind": "connection",
      "required": true,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "DIGITALOCEAN_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "DIGITALOCEAN_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "CTF_API_URL",
      "kind": "input",
      "required": false,
      "sensitive": false,
      "machines": [
        "database",
        "database-init-1"
      ],
      "default": "",
      "deliver": [
        {
          "via": "env",
          "var": "CTF_API_URL",
          "steps": [
            "start"
          ]
        }
      ]
    },
    {
      "name": "CTF_LAUNCH_TOKEN",
      "kind": "input",
      "required": false,
      "sensitive": true,
      "machines": [
        "database",
        "database-init-1"
      ],
      "default": "",
      "deliver": [
        {
          "via": "env",
          "var": "CTF_LAUNCH_TOKEN",
          "steps": [
            "start"
          ]
        }
      ]
    }
  ],
  "networks": [],
  "machines": [
    {
      "name": "isoloom-docker-host",
      "role": "infra",
      "resources": {
        "cpus": 2,
        "memory_mb": 3072
      },
      "addresses": {}
    },
    {
      "name": "database",
      "role": "target",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "lab": "10.20.0.32"
      },
      "native": {
        "service": "database"
      },
      "volumes": [
        {
          "name": "evidence",
          "path": "/var/lib/ctf",
          "native": "invoice-portal-api_database-evidence"
        }
      ],
      "ports": [
        {
          "name": "mysql",
          "port": 3207,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "database-init-1",
      "role": "job",
      "of": "database",
      "addresses": {},
      "native": {
        "service": "database-init-1"
      }
    },
    {
      "name": "web",
      "role": "target",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 1024
      },
      "addresses": {
        "lab": "10.20.0.31"
      },
      "native": {
        "service": "web"
      },
      "ports": [
        {
          "name": "portal",
          "port": 80,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "fixed",
            "preferred": 80,
            "address": "${outputs.ip}"
          }
        }
      ]
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-check-database",
      "role": "check",
      "of": "database",
      "addresses": {},
      "native": {
        "service": "isoloom-check-database"
      }
    },
    {
      "name": "isoloom-check-web",
      "role": "check",
      "of": "web",
      "addresses": {},
      "native": {
        "service": "isoloom-check-web"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the Docker host in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "docker",
        "note": "Installing Docker in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -s",
          "host": "${outputs.ip}",
          "user": "root",
          "wait_s": "300"
        },
        "stdin": "setup.sh",
        "timeout_s": 1800
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "project",
        "note": "Copying the project into the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo rm -rf /opt/isoloom && sudo mkdir -p /opt/isoloom && sudo tar -xzf - -C /opt/isoloom",
          "host": "${outputs.ip}",
          "user": "root"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 600
      },
      {
        "id": "start",
        "note": "Starting the lab's containers in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name invoice-portal-api --file .isoloom/docker/compose.yml up --detach --build --pull missing --wait --wait-timeout 600",
          "host": "${outputs.ip}",
          "user": "root"
        },
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the Docker host exists and booted"
    },
    {
      "kind": "step_ok",
      "step": "start",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The Docker host's address: SSH reaches it there, and its containers' published ports answer there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user the runner's key lets in on the Docker host.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    },
    {
      "name": "web_portal",
      "description": "web's portal (port 80).",
      "role": "entry",
      "sensitive": false,
      "format": "http://${host.web}:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "web",
        "port": "portal"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from the environment's networks",
        "checks": [
          {
            "name": "the API refuses a request without its key",
            "kind": "http",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "build/check/check.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          }
        ],
        "step": {
          "id": "check-networks",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name invoice-portal-api --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check",
            "host": "${outputs.ip}",
            "user": "root"
          },
          "timeout_s": 120
        },
        "on_timeout": [
          {
            "id": "rm-check-networks",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=invoice-portal-api --filter label=com.docker.compose.service=isoloom-check --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "root"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-database",
        "from": "from database",
        "checks": [
          {
            "name": "web:80 from database",
            "kind": "http",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-database",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name invoice-portal-api --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-database",
            "host": "${outputs.ip}",
            "user": "root"
          },
          "timeout_s": 105
        },
        "on_timeout": [
          {
            "id": "rm-check-database",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=invoice-portal-api --filter label=com.docker.compose.service=isoloom-check-database --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "root"
            },
            "timeout_s": 60
          }
        ]
      },
      {
        "id": "isoloom-check-web",
        "from": "from web",
        "checks": [
          {
            "name": "database:3207 from web",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-web",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name invoice-portal-api --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check-web",
            "host": "${outputs.ip}",
            "user": "root"
          },
          "timeout_s": 105
        },
        "on_timeout": [
          {
            "id": "rm-check-web",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=invoice-portal-api --filter label=com.docker.compose.service=isoloom-check-web --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "root"
            },
            "timeout_s": 60
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  },
  "guest": {
    "machine": "isoloom-docker-host",
    "host": "${outputs.ip}",
    "status": {
      "id": "ps",
      "action": "ssh.run",
      "with": {
        "command": "if command -v docker >/dev/null; then sudo docker compose --project-name invoice-portal-api ps --all --format json; fi",
        "host": "${outputs.ip}",
        "user": "root"
      },
      "timeout_s": 60
    }
  }
}
